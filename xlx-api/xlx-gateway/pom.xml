<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 网关模块：唯一可运行的 Spring Boot 应用，聚合所有业务模块 -->
    <parent>
        <groupId>com.xlx</groupId>
        <artifactId>xlx-api</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>xlx-gateway</artifactId>
    <name>xlx-gateway</name>
    <description>网关模块 — Spring Boot 启动入口、公开 API 聚合（BFF）、CORS/拦截器配置</description>

    <!--
    模块说明：xlx-gateway（网关/启动模块）
    ============================================================
    职责：唯一可运行的 Spring Boot 应用，聚合所有业务模块
    包名：com.xlx.api
    依赖：xlx-auth, xlx-product, xlx-content, xlx-inquiry, xlx-file, xlx-config

    包含文件（3 个 Java + 3 个资源文件）：
      XlxApiApplication.java    — Spring Boot 启动类（@MapperScan 扫描所有模块 Mapper）
      controller/publicc/PublicController.java — BFF 聚合控制器（前台公开 API）
      config/WebMvcConfig.java  — 全局配置（CORS、静态资源、JWT 拦截器注册）

      resources/application.yml         — 应用配置（数据库、JWT、文件上传等）
      resources/db/migration/V1__init_schema.sql — 数据库表结构（10 张表）
      resources/db/migration/V2__seed_data.sql   — 初始种子数据（管理员、分类、配置）

    关键设计：
      1. @MapperScan("com.xlx.api.**.mapper") 确保跨模块 Mapper 发现
      2. PublicController 作为 BFF 聚合各模块 Service，供前台调用
      3. WebMvcConfig 注册 AuthInterceptor 拦截 /api/admin/** 路径
      4. 仅本模块配置 spring-boot-maven-plugin，打可执行 JAR
    ============================================================
    -->

    <dependencies>
        <!-- 业务模块（通过依赖自动注册为 Spring Bean） -->
        <dependency>
            <groupId>com.xlx</groupId>
            <artifactId>xlx-auth</artifactId>
        </dependency>
        <dependency>
            <groupId>com.xlx</groupId>
            <artifactId>xlx-product</artifactId>
        </dependency>
        <dependency>
            <groupId>com.xlx</groupId>
            <artifactId>xlx-content</artifactId>
        </dependency>
        <dependency>
            <groupId>com.xlx</groupId>
            <artifactId>xlx-inquiry</artifactId>
        </dependency>
        <dependency>
            <groupId>com.xlx</groupId>
            <artifactId>xlx-file</artifactId>
        </dependency>
        <dependency>
            <groupId>com.xlx</groupId>
            <artifactId>xlx-config</artifactId>
        </dependency>

        <!-- MySQL 驱动（运行时） -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Flyway 数据库迁移（启动时自动执行 SQL 脚本） -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>

        <!-- 测试 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>2.2.224</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 仅 gateway 模块打可执行 JAR -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
