<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 父 POM：继承 Spring Boot 依赖管理 -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.5</version>
        <relativePath/>
    </parent>

    <groupId>com.xlx</groupId>
    <artifactId>xlx-api</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>xlx-api</name>
    <description>鑫联信金属丝网厂 — 模块化单体后端（微服务架构预留）</description>

    <!--
    ============================================================
    模块总览（模块化单体 / Modular Monolith）
    ============================================================
    采用 Maven 多模块结构，每个业务域独立模块，通过 gateway 聚合。
    未来可将各模块拆分为独立微服务，当前以单体方式部署。

    模块依赖关系：
      xlx-common  ← 所有模块依赖（公共库）
      xlx-auth    ← xlx-common（认证模块）
      xlx-product ← xlx-common（产品模块）
      xlx-content ← xlx-common（内容模块）
      xlx-inquiry ← xlx-common（询盘模块）
      xlx-file    ← xlx-common（文件模块）
      xlx-config  ← xlx-common（配置模块）
      xlx-gateway ← 以上所有模块（唯一可运行的 Spring Boot 应用）

    API 路径：
      /api/admin/**  — 后台管理接口（JWT 鉴权）
      /api/public/** — 前台展示接口（无需鉴权）

    数据库：
      所有模块共用 MySQL 数据库 xlx，通过 @TableName 区分表归属。
    ============================================================
    -->

    <!-- 子模块列表 -->
    <modules>
        <module>xlx-common</module>
        <module>xlx-auth</module>
        <module>xlx-product</module>
        <module>xlx-content</module>
        <module>xlx-inquiry</module>
        <module>xlx-file</module>
        <module>xlx-config</module>
        <module>xlx-gateway</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <mybatis-plus.version>3.5.6</mybatis-plus.version>
        <jjwt.version>0.12.5</jjwt.version>
        <easyexcel.version>4.0.3</easyexcel.version>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>
                        --add-opens java.base/java.lang=ALL-UNNAMED --add-opens java.base/java.lang.reflect=ALL-UNNAMED --add-opens java.base/java.util=ALL-UNNAMED
                    </argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <!-- 统一依赖版本管理，子模块无需重复声明版本号 -->
    <dependencyManagement>
        <dependencies>
            <!-- 内部模块 -->
            <dependency>
                <groupId>com.xlx</groupId>
                <artifactId>xlx-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.xlx</groupId>
                <artifactId>xlx-auth</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.xlx</groupId>
                <artifactId>xlx-product</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.xlx</groupId>
                <artifactId>xlx-content</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.xlx</groupId>
                <artifactId>xlx-inquiry</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.xlx</groupId>
                <artifactId>xlx-file</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.xlx</groupId>
                <artifactId>xlx-config</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- 外部依赖 -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-api</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-impl</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-jackson</artifactId>
                <version>${jjwt.version}</version>
            </dependency>

            <dependency>
                <groupId>com.alibaba</groupId>
                <artifactId>easyexcel</artifactId>
                <version>${easyexcel.version}</version>
            </dependency>

            <!-- 测试依赖（版本由 spring-boot-starter-parent 管理） -->
        </dependencies>
    </dependencyManagement>
</project>
