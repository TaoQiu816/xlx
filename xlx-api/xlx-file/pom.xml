<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 文件上传模块：文件上传与记录管理 -->
    <parent>
        <groupId>com.xlx</groupId>
        <artifactId>xlx-api</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>xlx-file</artifactId>
    <name>xlx-file</name>
    <description>文件上传模块 — 文件上传、类型校验、记录管理</description>

    <!--
    模块说明：xlx-file（文件上传模块）
    ============================================================
    职责：文件上传、类型/大小校验、危险文件拦截、上传记录管理
    包名：com.xlx.api.file
    依赖：xlx-common

    包含文件（4 个）：
      entity/FileUpload.java        — 文件上传记录实体（file_upload 表）
      mapper/FileUploadMapper.java  — 文件上传 Mapper
      service/FileUploadService.java — 文件上传服务（校验、存储、记录）
      controller/UploadController.java — 文件上传接口

    安全限制：
      允许类型：jpg,jpeg,png,gif,webp,pdf,doc,docx,xls,xlsx,txt
      单文件上限：10MB
      拒绝可执行文件（.exe,.bat,.sh,.js 等）

    API 路径：/api/admin/upload/**
    ============================================================
    -->

    <dependencies>
        <dependency>
            <groupId>com.xlx</groupId>
            <artifactId>xlx-common</artifactId>
        </dependency>

        <!-- 测试 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>2.2.224</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
